{
    "name": "shared-hxp-header",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/shared-hxp/navigation/header/src",
    "prefix": "hxp",
    "projectType": "library",
    "tags": ["scope:shared-hxp-navigation-header"],
    "targets": {
        "build": {
            "executor": "@nx/angular:ng-packagr-lite",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "options": {
                "project": "libs/shared-hxp/navigation/header/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "{projectRoot}/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "{projectRoot}/tsconfig.lib.json"
                },
                "adf": {
                    "tsConfig": "{projectRoot}/tsconfig.lib.adf.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "{projectRoot}/jest.config.ts",
                "passWithNoTests": true
            },
            "configurations": {
                "adf": {
                    "jestConfig": "{projectRoot}/jest.adf.config.ts",
                    "codeCoverage": false,
                    "silent": true
                }
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "stylelint": {}
    }
}
