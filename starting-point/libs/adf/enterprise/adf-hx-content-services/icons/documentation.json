            "standalone": true,
            "description": "<p>Component representing a search action icon.</p>\n<p>To use the <code>SearchActionIconComponent</code>, you need first to import the component in your module</p>\n<div><pre class=\"line-numbers\"><code class=\"language-ts\">import { SearchActionIconComponent } from &#39;&#64;alfresco/adf-hx-content-services/icons&#39;;\n&#64;NgModule({\n    imports: [\n        SearchActionIconComponent,\n        ...\n    ],\n   [...]\n})\nexport class AppModule {}</code></pre></div><p>Then use it in your Angular template as shown in the example below:</p>\n<div><pre class=\"line-numbers\"><code class=\"language-html\"> &lt;hxp-search-action-icon [actionIcon]=&quot;actionIcon&quot; [actionAlt]= &quot;actionAlt&quot;&gt;&lt;/hxp-search-action-icon&gt;</code></pre></div>",
            "rawdescription": "\n\nComponent representing a search action icon.\n\nTo use the `SearchActionIconComponent`, you need first to import the component in your module\n```ts\nimport { SearchActionIconComponent } from '@alfresco/adf-hx-content-services/icons';\n@NgModule({\n    imports: [\n        SearchActionIconComponent,\n        ...\n    ],\n   [...]\n})\nexport class AppModule {}\n```\n\nThen use it in your Angular template as shown in the example below:\n```html\n <hxp-search-action-icon [actionIcon]=\"actionIcon\" [actionAlt]= \"actionAlt\"></hxp-search-action-icon>\n```",
            "type": "component",
            "sourceCode": "import { Component, Input, OnChanges } from '@angular/core';\nimport { SearchIcon } from '../configs/search-icons.config';\nimport { TranslateService } from '@ngx-translate/core';\n\n/**\n * Component representing a search action icon.\n *\n * To use the `SearchActionIconComponent`, you need first to import the component in your module\n * ```ts\n * import { SearchActionIconComponent } from '@alfresco/adf-hx-content-services/icons';\n * @NgModule({\n *     imports: [\n *         SearchActionIconComponent,\n *         ...\n *     ],\n *    [...]\n * })\n * export class AppModule {}\n * ```\n *\n * Then use it in your Angular template as shown in the example below:\n * @example\n *  <hxp-search-action-icon [actionIcon]=\"actionIcon\" [actionAlt]= \"actionAlt\"></hxp-search-action-icon>\n */\n@Component({\n    selector: 'hxp-search-action-icon',\n    templateUrl: './search-action-icon.component.html',\n    styleUrls: ['./search-action-icon.component.scss'],\n    standalone: true,\n})\nexport class SearchActionIconComponent implements OnChanges {\n    @Input()\n    actionIcon: SearchIcon = SearchIcon.SEARCH;\n    @Input()\n    actionAlt = '';\n\n    protected alt = '';\n\n    constructor(private translateService: TranslateService) {}\n\n    ngOnChanges() {\n        this.alt = this.actionAlt\n            ? this.actionAlt\n            : this.actionIcon === SearchIcon.SEARCH\n            ? this.translateService.instant('SEARCH.ICON.SEARCH')\n            : this.translateService.instant('SEARCH.ICON.CLEAR_INPUT');\n    }\n}\n",
