{
    "name": "adf-enterprise-adf-hx-content-services-ui",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/adf/enterprise/adf-hx-content-services/ui/src",
    "prefix": "hxp",
    "tags": ["scope:adf-enterprise-adf-hx-content-services-ui", "category:adf-enterprise"],
    "projectType": "library",
    "targets": {
        "compile": {
            "executor": "@nx/angular:ng-packagr-lite",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "options": {
                "project": "libs/adf/enterprise/adf-hx-content-services/ui/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/adf/enterprise/adf-hx-content-services/ui/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "libs/adf/enterprise/adf-hx-content-services/ui/tsconfig.lib.json"
                },
                "adf": {
                    "tsConfig": "libs/adf/enterprise/adf-hx-content-services/ui/tsconfig.lib.adf.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "move-dist": {
            "executor": "tools:move-dist",
            "options": {
                "source": "libs/adf/enterprise/adf-hx-content-services/ui/dist",
                "destination": "{workspaceRoot}/dist/{projectRoot}"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "configurations": {
                "production": {
                    "commands": [
                        "nx run adf-enterprise-adf-hx-content-services-ui:compile --configuration=production",
                        "nx run adf-enterprise-adf-hx-content-services-ui:move-dist"
                    ],
                    "parallel": false
                },
                "development": {
                    "commands": [
                        "nx run adf-enterprise-adf-hx-content-services-ui:compile --configuration=development",
                        "nx run adf-enterprise-adf-hx-content-services-ui:move-dist"
                    ],
                    "parallel": false
                },
                "adf": {
                    "commands": [
                        "nx run adf-enterprise-adf-hx-content-services-ui:compile --configuration=adf",
                        "nx run adf-enterprise-adf-hx-content-services-ui:move-dist"
                    ],
                    "parallel": false
                }
            },
            "defaultConfiguration": "production"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "libs/adf/enterprise/adf-hx-content-services/ui/jest.config.ts",
                "passWithNoTests": true,
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "libs/adf/enterprise/adf-hx-content-services/icons/src/assets",
                        "output": "assets"
                    }
                ],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "apps/workspace-hxp/src",
                        "libs/shared/core/src/styles",
                        "node_modules/@alfresco/adf-core/lib",
                        "libs/shared-hxp/idp-document-viewer/src/lib/theming",
                        "libs/shared/satori-like-styles/src"
                    ]
                },
                "styles": [
                    "node_modules/@hyland/icons/index.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons-outlined.css",
                    "apps/workspace-hxp/src/styles.scss"
                ]
            },
            "configurations": {
                "adf": {
                    "jestConfig": "{projectRoot}/jest.adf.config.ts",
                    "codeCoverage": false,
                    "silent": true
                }
            }
        },
        "lint": {},
        "storybook": {
            "executor": "@storybook/angular:start-storybook",
            "options": {
                "port": 4400,
                "configDir": "libs/adf/enterprise/adf-hx-content-services/ui/.storybook",
                "browserTarget": "adf-enterprise-adf-hx-content-services-ui:build-storybook",
                "compodoc": true,
                "compodocArgs": [
                    "-e",
                    "json",
                    "-d",
                    "libs/adf/enterprise/adf-hx-content-services/ui",
                    "--minimal",
                    "--disablePrivate",
                    "--disableInternal",
                    "--disableProtected",
                    "--disableLifeCycleHooks"
                ],
                "styles": [
                    "node_modules/cropperjs/dist/cropper.min.css",
                    "node_modules/pdfjs-dist/web/pdf_viewer.css",
                    "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "node_modules/@hyland/icons/index.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons-outlined.css",
                    "apps/workspace-hxp/src/styles.scss",
                    "node_modules/@hyland/icons/index.css"
                ],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "libs/adf/enterprise/adf-hx-content-services/ui/src/lib/components/document-tree",
                        "apps/workspace-hxp/src",
                        "libs/shared/core/src/styles",
                        "node_modules/@alfresco/adf-core/lib",
                        "libs/shared-hxp/idp-document-viewer/src/lib/theming",
                        "libs/shared/satori-like-styles/src"
                    ]
                }
            },
            "configurations": {
                "ci": {
                    "quiet": true
                }
            }
        },
        "build-storybook": {
            "executor": "@storybook/angular:build-storybook",
            "outputs": [
                "{options.outputDir}"
            ],
            "options": {
                "outputDir": "dist/storybook/adf-enterprise-adf-hx-content-services-ui",
                "configDir": "libs/adf/enterprise/adf-hx-content-services/ui/.storybook",
                "browserTarget": "adf-enterprise-adf-hx-content-services-ui:build-storybook",
                "compodoc": false,
                "styles": [
                    "node_modules/cropperjs/dist/cropper.min.css",
                    "node_modules/pdfjs-dist/web/pdf_viewer.css",
                    "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "node_modules/@hyland/icons/index.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons-outlined.css",
                    "apps/workspace-hxp/src/styles.scss",
                    "node_modules/@hyland/icons/index.css"
                ],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "libs/adf/enterprise/adf-hx-content-services/ui/src/lib/components/document-tree",
                        "apps/workspace-hxp/src",
                        "libs/shared/core/src/styles",
                        "node_modules/@alfresco/adf-core/lib",
                        "libs/shared-hxp/idp-document-viewer/src/lib/theming",
                        "libs/shared/satori-like-styles/src"
                    ]
                }
            },
            "configurations": {
                "ci": {
                    "quiet": true
                }
            }
        },
        "static-storybook": {
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "adf-enterprise-adf-hx-content-services-ui:build-storybook",
                "staticFilePath": "dist/storybook/adf-enterprise-adf-hx-content-services-ui"
            },
            "configurations": {
                "ci": {
                    "buildTarget": "adf-enterprise-adf-hx-content-services-ui:build-storybook:ci"
                }
            }
        }
    }
}
