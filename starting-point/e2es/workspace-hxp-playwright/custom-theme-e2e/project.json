{
    "name": "workspace-hxp-playwright-custom-theme-e2e",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "e2es/workspace-hxp-playwright/custom-theme-e2e/src",
    "prefix": "hxp",
    "targets": {
        "pree2e": {
            "executor": "@alfresco-dbp/monorepo/builders:app-config-envsub",
            "options": {
                "application": "workspace-hxp",
                "envs": [
                    {
                        "name": "APP_CONFIG_CUSTOM_CSS_PATH",
                        "value": "http://localhost:8080/assets/theme/custom.css"
                    },
                    {
                        "name": "APP_CONFIG_CUSTOM_FONT_PATH",
                        "value": "https://fonts.googleapis.com/css2?family=Oswald&display=swap"
                    },
                    {
                        "name": "APP_CONFIG_CUSTOM_HEADER_LOGO",
                        "value": "https://hxps-rc.studio.dev.experience.hyland.com/sys-workspace-cab2409f/rb/v1/files/logo"
                    },
                    {
                        "name": "APP_CONFIG_CUSTOM_HEADER_IMAGE",
                        "value": "https://hxps-rc.studio.dev.experience.hyland.com/sys-workspace-cab2409f/rb/v1/files/background"
                    },
                    {
                        "name": "APP_CONFIG_CUSTOM_HEADER_COLOR",
                        "value": "#DFDDDD"
                    },
                    {
                        "name": "APP_CONFIG_CUSTOM_HEADER_TEXT_COLOR",
                        "value": "#393939"
                    }
                ],
                "projectName": "sys-workspace",
                "externalScript": "/custom-script/fetch-dynamic-app-details.js"
            }
        },
        "e2e": {},
        "e2e-ff": {},
        "e2e-ff-dryrun": {},
        "lint": {},
        "codeowner": {}
    },
    "tags": [
        "scope:workspace-hxp-playwright-custom-theme-e2e",
        "type:e2e",
        "category:workspace-hxp",
        "automate"
    ],
    "implicitDependencies": [
        "workspace-hxp-playwright-app-shell-e2e"
    ]
}
