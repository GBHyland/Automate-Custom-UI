        },
        "e2e": {},
        "e2e-ff": {},
        "e2e-ff-dryrun": {},
        "lint": {},
        "codeowner": {}
    },
    "tags": [
        "scope:workspace-hxp-playwright-process-services-cloud-extension-processes-e2e",
        "type:e2e",
        "category:workspace-hxp",
        "automate"
    ],
    "implicitDependencies": [
        "workspace-hxp-process-services-cloud-extension-process-form-feature-shell"
