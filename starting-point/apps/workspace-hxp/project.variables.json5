{
  defaultContext: 'hxpsRc',
  variables: {
    HXPR_VERSION: '1.0.1174',
    APP_CONFIG_ECM_HOST: '{context.contentHost}',
    APP_CONFIG_BPM_HOST: '{context.processHost}',
    APP_CONFIG_PROVIDER: 'ALL',
    APP_CONFIG_OAUTH2_HOST: '{context.idpURL}',
    APP_CONFIG_OAUTH2_CLIENTID: '{context.studioClientId}',
    APP_CONFIG_OAUTH2_SCOPE: '{context.scope}',
    APP_CONFIG_OAUTH2_TOKEN_URL: '{context.idpURL}/connect/token',
    APP_CONFIG_OAUTH2_IMPLICIT_FLOW: false,
    APP_CONFIG_OAUTH2_CODE_FLOW: true,
    APP_CONFIG_OAUTH2_SILENT_LOGIN: true,
    APP_CONFIG_OAUTH2_REDIRECT_SILENT_IFRAME_URI: '{context.processHost}/assets/silent-refresh.html',
    APP_CONFIG_OAUTH2_REDIRECT_LOGIN: '/',
    APP_CONFIG_OAUTH2_REDIRECT_LOGOUT: '/',
    APP_CONFIG_PLUGIN_CONTENT_SERVICE: true,
    APP_CONFIG_LANDING_PAGE: '',
    APP_CONFIG_APPS_DEPLOYED: '{context.deployedApps}',
    APP_CONFIG_CUSTOM_MODELED_EXTENSION: {},
    APP_CONFIG_ANALYTICS_PENDO_ENABLED: false,
    APP_CONFIG_ANALYTICS_PENDO_KEY: '',
    APP_CONFIG_ANALYTICS_PENDO_DISABLE_GUIDES: false,
    APP_CONFIG_ANALYTICS_PENDO_EXCLUDE_ALL_TEXT: false,
    APP_CONFIG_CUSTOMER_NAME: '',
    APP_CONFIG_SERVER_TIME_URL: '{context.processHost}/identity-adapter-service/v1/server/time',
    APP_CONFIG_CUSTOM_CSS_PATH: '',
    APP_CONFIG_CUSTOM_FONT_PATH: '',
    APP_CONFIG_CUSTOM_HEADER_LOGO: '',
    APP_CONFIG_CUSTOM_HEADER_IMAGE: '',
    APP_CONFIG_CUSTOM_HEADER_COLOR: '#ffffff',
    APP_CONFIG_CUSTOM_HEADER_TEXT_COLOR: '#000000',
    UI_TYPE: 'DEFAULT_UI',
  },
}