import { AppNames,
    CustomConfig,
    getExcludedTestsRegExpArray,
    getGlobalConfig } from '@alfresco-dbp/playwright/shared';
import { Project, defineConfig } from '@playwright/test';
import EXCLUDED_JSON from './exclude.tests.json';

const projectConfiguration: Project<CustomConfig>[] = [{
    name: 'Example',
    use: {
        users: [''],
        environmentCheck: {
            apps: false,
            envUp: true
        }
    }
}];

export default defineConfig<CustomConfig>({
    <% if (appName === 'admin-apa') { %>
      ...getGlobalConfig(AppNames.AdminApa, projectConfiguration),
      grepInvert: getExcludedTestsRegExpArray(EXCLUDED_JSON, AppNames.AdminApa),
      <% } else if (appName === 'content-ee-apa') { %>
        ...getGlobalConfig(AppNames.ContentEeApa, projectConfiguration),
        grepInvert: getExcludedTestsRegExpArray(EXCLUDED_JSON, AppNames.ContentEeApa),
      <% } else if (appName === 'studio-apa') { %>
        ...getGlobalConfig(AppNames.StudioApa, projectConfiguration),
        grepInvert: getExcludedTestsRegExpArray(EXCLUDED_JSON, AppNames.StudioApa),
      <% } else if (appName === 'studio-hxp') { %>
        ...getGlobalConfig(AppNames.HxPStudio, projectConfiguration),
        grepInvert: getExcludedTestsRegExpArray(EXCLUDED_JSON, AppNames.HxPStudio),
      <% } else if (appName === 'workspace-hxp') { %>
        ...getGlobalConfig(AppNames.WorkSpaceHxP, projectConfiguration),
        grepInvert: getExcludedTestsRegExpArray(EXCLUDED_JSON, AppNames.WorkSpaceHxP),
      <% } else { %>
        ...getGlobalConfig(),
        grepInvert: getExcludedTestsRegExpArray(EXCLUDED_JSON, ''),
    <% }; %>
});
