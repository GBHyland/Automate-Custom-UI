import { test, expect } from '../fixtures/page-initialization';

test.describe('My first test', () => {

    test.beforeEach(async ({ examplePage }) => {
        await examplePage.navigate();
    });

    test.afterEach(async ({ examplePage }) => {
        // delete me and files created in your tests
    });

    test(`[TestRail-Id] Should be able to test something`, async ({ examplePage }) => {
        const username = 'username';
        const password = 'password';

        await examplePage.actionNavbar.createUserButton.click();
        await examplePage.createUserModal.createUser(username, password);

        await expect(examplePage.dataTable.getRowByName('username')).toContainText(username);
    });
});
