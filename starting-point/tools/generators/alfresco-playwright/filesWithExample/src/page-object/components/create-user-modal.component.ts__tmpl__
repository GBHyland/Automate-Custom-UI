import { BaseComponent } from '@alfresco-dbp/playwright/shared';
import { Page } from '@playwright/test';

export class ExampleCreateUserModalComponent extends BaseComponent {
    private static rootElement = '#rootId';

    constructor(page: Page) {
        super(page, ExampleCreateUserModalComponent.rootElement);
    }

    usernameLocator = this.getChild('#username');
    passwordLocator = this.getChild('#password');

    async createUser(username: string, password: string): Promise<void> {
        await this.usernameLocator.type(username);
        await this.passwordLocator.type(password);
    }
}
