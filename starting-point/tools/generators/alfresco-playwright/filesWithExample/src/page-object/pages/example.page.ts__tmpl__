import { BasePage, DataTable } from '@alfresco-dbp/playwright/shared';
import { Page } from '@playwright/test';
import { ExampleCreateUserModalComponent,
    ExampleActionNavbarComponent } from '../';

export class ExamplePage extends BasePage {
    private static pageUrl = 'example'
    exampleTitle = 'Fake title page';

    constructor(page: Page) {
        super(page, ExamplePage.pageUrl);
    }

    dataTable = new DataTable(this.page);
    createUserModal = new ExampleCreateUserModalComponent(this.page);
    actionNavbar = new ExampleActionNavbarComponent(this.page);
}
