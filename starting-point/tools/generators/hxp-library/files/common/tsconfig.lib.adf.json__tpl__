{
    "extends": "<%= offsetFromRoot %>tsconfig.adf.json",
    "compilerOptions": {
        "outDir": "<%= offsetFromRoot %>dist/out-tsc",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "noImplicitAny": false,
        "strictPropertyInitialization": false,
        "types": []
    },
    "exclude": ["src/test.ts", "**/*.spec.ts", "**/*.test.ts"],
    "include": ["**/*.ts"]
}
